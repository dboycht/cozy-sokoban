; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters go through internal validation.

[application]

config/name="Cozy Sokoban"
config/description="像素风闯关推箱子治愈风小游戏"
run/main_scene="res://scenes/title.tscn"
config/version="1.0.2"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://assets/sprites/icon.svg"
config/windows_native_icon="res://assets/icons/cozy.ico"

[autoload]

Global="*res://scripts/global.gd"
Audio="*res://scripts/audio.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=576
window/size/window_width_override=1280
window/size/window_height_override=1152
window/stretch/mode="viewport"
window/stretch/aspect="keep"

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"

